{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "View|ReadFile|Read",
        "hooks": [
          {
            "type": "command",
            "if": "View(*runbook.md*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_claude.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "ReadFile(*runbook.md*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_claude.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Read(*runbook.md*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_claude.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|WriteFile",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*global_roles.sql*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_claude.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Write(*users_permissions_assessment_report.md*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_claude.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Write(*users_permissions_migration_report.md*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_claude.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "WriteFile(*global_roles.sql*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_claude.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "WriteFile(*users_permissions_assessment_report.md*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_claude.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "WriteFile(*users_permissions_migration_report.md*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_claude.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*infrastructure-discoverer.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_claude.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
